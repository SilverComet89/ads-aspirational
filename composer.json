{
    "name": "my/project",
    "description": "Project template for Drupal 8 projects with composer",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "",
            "role": ""
        }
    ],
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        "asset-packagist": {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    },
    "require": {
        "php": "^5.5.9|>=7.0.8",
        "composer/installers": "^2.2",
        "cweagans/composer-patches": "^1.6.5",
        "drupal-composer/drupal-scaffold": "^2.5.4",
        "drupal/addtoany": "^1.10.0",
        "drupal/admin_toolbar": "^1.26.0",
        "drupal/adminimal_admin_toolbar": "^1.9.0",
        "drupal/advagg": "^3.5.0",
        "drupal/better_exposed_filters": "^3.0.0-alpha6",
        "drupal/block_class": "^1.0.0",
        "drupal/bootstrap_layouts": "^5.1.0",
        "drupal/captcha": "^1.0.0-beta1",
        "drupal/coffee": "^1.0.0-beta2",
        "drupal/colorbox": "^1.4.0",
        "drupal/colorbox_load": "^1.0.0-rc2",
        "drupal/config_direct_save": "^1.0.0",
        "drupal/config_installer": "^1.8.0",
        "drupal/contribute": "^1.0.0-beta7",
        "drupal/core": "^8.7.6",
        "drupal/ctools": "^3.2.0",
        "drupal/devel": "^2.0.0",
        "drupal/disqus": "^1.0.0-rc3",
        "drupal/dropzonejs": "^1.0.0-alpha8",
        "drupal/ds": "^3.3.0",
        "drupal/embed": "^1.0.0",
        "drupal/entity_browser": "^1.7.0",
        "drupal/entity_embed": "^1.0.0-beta2",
        "drupal/entity_reference_revisions": "^1.6.0",
        "drupal/field_formatter_class": "^1.1.0",
        "drupal/file_browser": "^1.1.0",
        "drupal/fontawesome": "^1.4.0",
        "drupal/google_analytics": "^2.4.0",
        "drupal/image_effects": "^1.3.0",
        "drupal/imce": "^1.5.0",
        "drupal/instagram_block": "^2.0.0-beta2",
        "drupal/jcarousel": "^4.0.0",
        "drupal/jquery_carousel": "^1.0.0-beta1",
        "drupal/libraries": "^3.0.0-alpha1",
        "drupal/linked_field": "^1.1.0",
        "drupal/mailsystem": "^4.1.0",
        "drupal/metatag": "^1.8.0",
        "drupal/ng_lightbox": "^1.0.0-beta3",
        "drupal/pagerer": "^1.4.0",
        "drupal/paragraphs": "^1.6.0",
        "drupal/path_redirect_import": "^1.0.0-beta1",
        "drupal/pathauto": "^1.3.0",
        "drupal/recaptcha": "^2.4.0",
        "drupal/redirect": "^1.3.0",
        "drupal/responsive_menu": "^2.6.0",
        "drupal/sendgrid_integration": "^1.2.0",
        "drupal/token": "^1.5.0",
        "drupal/twig_tweak": "^1.9.0",
        "drupal/views_fieldsets": "^3.3.0",
        "drupal/views_infinite_scroll": "^1.5.0",
        "drupal/views_slideshow": "^4.6.0",
        "drupal/webform": "^5.1.0",
        "drupal/xmlsitemap": "^1.0.0-alpha3",
        "grasmash/drupal-security-warning": "^1.0.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "wikimedia/composer-merge-plugin": "^1.4.1"
    },
    "require-dev": {
        "drush/drush": "^9.7"
    },
    "config": {
        "sort-packages": true,
        "discard-changes": true,
        "allow-plugins": {
            "composer/installers": true,
            "oomphinc/composer-installers-extender": true
        }
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "extra": {
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": [],
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "drush/Commands/{$name}": [
                "type:drupal-drush"
            ],
            "web/core": [
                "type:drupal-core"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ]
        },
        "merge-plugin": {
            "include": [
                "web/modules/custom/*/composer.json"
            ],
            "replace": false,
            "ignore-duplicates": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
